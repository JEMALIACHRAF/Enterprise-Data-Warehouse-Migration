# .env.example — Copie vers .env et remplace les valeurs
# Ce fichier EST versionné. Le fichier .env NE L'EST PAS.

# ─── Oracle (Docker local) ────────────────────────────────────────────────────
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_USER=migration_reader
ORACLE_PASSWORD=CHANGE_ME

# ─── Snowflake ────────────────────────────────────────────────────────────────
# Ton compte Snowflake : format abc12345.eu-central-1
SNOWFLAKE_ACCOUNT=CHANGE_ME
SNOWFLAKE_USER=migration_svc
SNOWFLAKE_PASSWORD=CHANGE_ME
SNOWFLAKE_DATABASE=FINANCE_DWH_DEV
SNOWFLAKE_SCHEMA=CORE
SNOWFLAKE_WAREHOUSE=MIGRATION_WH
# Utilisé uniquement en prod (GKE + Secret Manager), laisser vide en dev
SNOWFLAKE_PRIVATE_KEY_PEM=

# ─── GCS ──────────────────────────────────────────────────────────────────────
GCS_BUCKET=CHANGE_ME
# Chemin vers la clé JSON de ton service account GCP
GOOGLE_APPLICATION_CREDENTIALS=/Users/TON_USER/.gcp/spark-migration-key.json

# ─── Notifications (optionnel) ────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
